# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_campus?schema=public"

# JWT
JWT_SECRET="replace-this-with-a-long-random-secret-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# CORS - frontend origin
CLIENT_URL="http://localhost:5173"

# File uploads
MAX_FILE_SIZE_MB=5
